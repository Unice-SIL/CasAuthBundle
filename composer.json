{
  "name": "prayno/casauth-bundle",
  "type": "symfony-bundle",
  "description": "Basic CAS (SSO) authenticator for Symfony",
  "keywords": ["PRayno", "CAS", "SSO", "Symfony"],
  "license": "MIT",
  "authors": [
    {
      "name": "Pierre Raynaud",
      "email": "pierre.raynaud@uca.fr"
    }
  ],
  "require": {
    "php": ">=8.2",
    "symfony/config": "^5.4|^6.0|^7.0",
    "symfony/dependency-injection": "^5.4|^6.0|^7.0",
    "symfony/event-dispatcher-contracts": "^2.5|^3.0",
    "symfony/http-foundation": "^5.4|^6.0|^7.0",
    "symfony/http-kernel": "^5.4|^6.0|^7.0",
    "symfony/security-core": "^5.4|^6.0|^7.0",
    "symfony/security-http": "^5.4|^6.0|^7.0",
    "symfony/security-bundle": "^5.4|^6.0|^7.0",
    "guzzlehttp/guzzle": "^7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "autoload": {
    "psr-4": { "PRayno\\CasAuthBundle\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "PRayno\\CasAuthBundle\\Tests\\": "tests/" }
  },
  "extra": {
  }
}
